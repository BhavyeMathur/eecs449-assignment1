"""Warm, photo-forward React Native design tokens for Daybook."""

import from "@jac/mobui" { StyleSheet }

obj Palette {
    has bg: str = "#f3efe7", surface: str = "#fffdf8",
        surfaceAlt: str = "#e7dfd3", border: str = "#d8d0c4",
        field: str = "#faf7f1", text: str = "#282521",
        muted: str = "#7f776e", accent: str = "#282521",
        onAccent: str = "#ffffff", success: str = "#3f6b55";
}

glob:pub C: Palette = Palette();

glob:pub styles = StyleSheet.create({
    screen: {flex: 1, backgroundColor: C.bg},
    content: {width: "100%", maxWidth: 620, alignSelf: "center", padding: 18, gap: 18, paddingBottom: 64},
    header: {flexDirection: "row", alignItems: "center", justifyContent: "space-between", paddingTop: 20},
    eyebrow: {color: C.muted, fontSize: 11, fontWeight: "700", letterSpacing: 2},
    title: {color: C.text, fontSize: 30, fontWeight: "600"},
    reminderPill: {paddingVertical: 8, paddingHorizontal: 12, borderRadius: 999, backgroundColor: C.surfaceAlt},
    reminderText: {color: C.text, fontSize: 11, fontWeight: "600"},
    promptCard: {padding: 22, gap: 8, borderRadius: 20, backgroundColor: "#d6dfd9"},
    promptLabel: {color: "#496155", fontSize: 10, fontWeight: "700", letterSpacing: 1.5},
    promptText: {color: C.text, fontSize: 24, lineHeight: 31, fontWeight: "500"},
    promptCount: {color: C.muted, fontSize: 12},
    intentionCard: {padding: 18, gap: 12, borderRadius: 20, borderWidth: 1, borderColor: C.border, backgroundColor: C.surface},
    intentionHeading: {flexDirection: "row", alignItems: "center", justifyContent: "space-between"},
    intentionHint: {marginTop: 4, color: C.muted, fontSize: 12},
    intentionInput: {color: C.text, fontSize: 18, lineHeight: 24, backgroundColor: C.field, borderRadius: 12, paddingVertical: 12, paddingHorizontal: 14},
    intentionCheck: {width: 32, height: 32, alignItems: "center", justifyContent: "center", borderWidth: 2, borderColor: "#c75f43", borderRadius: 999},
    intentionCheckDone: {backgroundColor: "#c75f43"},
    intentionCheckText: {color: "#ffffff", fontSize: 15, fontWeight: "700"},
    captureCard: {padding: 14, gap: 12, borderRadius: 22, backgroundColor: C.surface},
    preview: {width: "100%", height: 340, borderRadius: 16, backgroundColor: C.surfaceAlt},
    previewEmpty: {height: 240, alignItems: "center", justifyContent: "center", gap: 8, borderRadius: 16, backgroundColor: C.surfaceAlt},
    previewGlyph: {color: C.muted, fontSize: 42},
    previewText: {color: C.muted, fontSize: 14},
    captureActions: {flexDirection: "row", gap: 8},
    input: {color: C.text, fontSize: 15, backgroundColor: C.field, borderWidth: 1, borderColor: C.border, borderRadius: 12, paddingVertical: 12, paddingHorizontal: 14},
    fieldGroup: {gap: 8},
    fieldLabel: {color: C.muted, fontSize: 10, fontWeight: "700", letterSpacing: 1.4},
    fieldHint: {color: C.muted, fontSize: 11},
    kindRow: {gap: 7},
    threadChoices: {flexDirection: "row", flexWrap: "wrap", gap: 7},
    threadChoice: {flexDirection: "row", alignItems: "center", gap: 7, paddingVertical: 8, paddingHorizontal: 10, borderWidth: 1, borderColor: C.border, borderRadius: 999, backgroundColor: C.field},
    threadChoiceSelected: {borderColor: "#c75f43", backgroundColor: "#f3dfd9"},
    threadChoiceDot: {width: 8, height: 8, borderRadius: 999},
    threadChoiceText: {color: C.text, fontSize: 11, fontWeight: "600"},
    threadChoiceMark: {color: "#c75f43", fontSize: 12, fontWeight: "700"},
    notice: {color: C.success, fontSize: 13, textAlign: "center"},
    sectionHeader: {flexDirection: "row", alignItems: "center", justifyContent: "space-between", marginTop: 12},
    sectionTitle: {color: C.text, fontSize: 22, fontWeight: "600"},
    sectionMeta: {color: C.muted, fontSize: 12},
    dayBlock: {gap: 10},
    dayHeader: {flexDirection: "row", justifyContent: "space-between", alignItems: "center", paddingBottom: 6, borderBottomWidth: 1, borderBottomColor: C.border},
    dayDate: {color: C.text, fontSize: 14, fontWeight: "600"},
    dayCount: {color: C.muted, fontSize: 12},
    momentCard: {overflow: "hidden", borderRadius: 18, backgroundColor: C.surface, borderWidth: 1, borderColor: C.border},
    momentImage: {width: "100%", height: 280, backgroundColor: C.surfaceAlt},
    textMoment: {height: 130, alignItems: "center", justifyContent: "center", backgroundColor: "#d7e1dc"},
    textMomentGlyph: {color: C.muted, fontSize: 38},
    momentBody: {padding: 14, gap: 5},
    momentKind: {color: C.muted, fontSize: 10, fontWeight: "700", letterSpacing: 1.4},
    momentCaption: {color: C.text, fontSize: 16, lineHeight: 22},
    momentThreads: {color: C.muted, fontSize: 11},
    deleteLink: {alignSelf: "flex-start", marginTop: 6, paddingVertical: 5},
    deleteLinkText: {color: "#a55344", fontSize: 11, fontWeight: "600"},
    deleteConfirm: {gap: 9, marginTop: 8, padding: 11, borderRadius: 11, backgroundColor: "#f6e6e1"},
    deletePrompt: {color: C.text, fontSize: 12, fontWeight: "600"},
    deleteActions: {flexDirection: "row", gap: 18},
    keepLabel: {color: C.muted, fontSize: 11, fontWeight: "600"},
    deleteLabel: {color: "#a13f32", fontSize: 11, fontWeight: "700"},
    threadRow: {gap: 10, paddingBottom: 4},
    threadCard: {width: 180, minHeight: 130, padding: 16, justifyContent: "flex-end", borderRadius: 18},
    threadHash: {color: "rgba(255,255,255,0.7)", fontSize: 22},
    threadName: {color: "#ffffff", fontSize: 20, fontWeight: "700"},
    threadCount: {color: "rgba(255,255,255,0.8)", fontSize: 11}
});
